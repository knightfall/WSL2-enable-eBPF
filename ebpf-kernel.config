# ----------------------------------------------------------------------------
# Kernel config addendum for the eBPF observability / dataplane stack on WSL2.
#
# Target workloads:
#   - Docker (overlay2, bridge networking, iptables/nftables)
#   - Tetragon (kprobes, tracepoints, BPF-LSM enforcement)
#   - Cilium  (tc-BPF, conntrack, overlays, WireGuard/IPsec)
#   - OpenTelemetry OBI (uprobes, CO-RE, cgroup-BPF)
#   - Envoy (TPROXY; application-specific kTLS support is separate)
#
# Apply using scripts/configure-kernel.sh, which preserves the base LSM list,
# appends bpf, runs olddefconfig, and validates all requested values.
# ----------------------------------------------------------------------------

# === Networking baseline (mostly inherited; asserted for this profile) ===
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_CRYPTO=y
CONFIG_KEYS=y

# === BTF / CO-RE — required for Tetragon, OBI, Cilium ===
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# === BPF core (most already set by config-wsl; pinned here for safety) ===
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_BPF_LSM=y
CONFIG_CGROUP_BPF=y
CONFIG_XDP_SOCKETS=y
# Optional sockmap/sk_msg support; not a claim that every workload uses it.
CONFIG_BPF_STREAM_PARSER=y
CONFIG_BPF_EVENTS=y

# === Tracing — Tetragon (kprobes/tracepoints) + OBI (uprobes) ===
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_TRACEPOINTS=y
CONFIG_PERF_EVENTS=y
# Tetragon's kprobe Override action requires both options.
CONFIG_FUNCTION_ERROR_INJECTION=y
CONFIG_BPF_KPROBE_OVERRIDE=y

# === tc-BPF — Cilium datapath ===
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_ACT_MIRRED=y

# === LWT-BPF — Cilium host routing / IPv6 ===
CONFIG_LWTUNNEL=y
CONFIG_LWTUNNEL_BPF=y

# === Cgroup v2 controllers — Docker, Tetragon process correlation ===
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_SOCK_CGROUP_DATA=y

# === Netfilter / iptables / conntrack — Docker, kube-proxy fallback, Cilium iptables mode ===
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
# The CT target depends on at least one raw table; keep both protocols built in.
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_RAW=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
# Transparent proxy support.
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_CT=y

# === Virtual netdevs — container networking + Cilium overlays ===
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VXLAN=y
CONFIG_GENEVE=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_DUMMY=y
CONFIG_IFB=y

# === Crypto / IPsec / WireGuard — Cilium transparent encryption ===
CONFIG_XFRM=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_ALGO=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_WIREGUARD=y

# === Storage — Docker overlay2 + alternate drivers ===
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y

# === Security primitives — required by Docker/runc, Tetragon, BPF-LSM ===
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_AUDIT=y
# CONFIG_LSM is extended by configure-kernel.sh to preserve Microsoft's order.

# === Misc performance / observability ===
# Distinguish this profile from Microsoft's stock kernel at runtime.
CONFIG_LOCALVERSION="-microsoft-standard-WSL2-ebpf"
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_HUGETLBFS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_IKHEADERS=y
